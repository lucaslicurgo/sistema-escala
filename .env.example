# Copie este arquivo para .env e preencha:

# Senha de acesso ao sistema
ADMIN_PASSWORD=troque-esta-senha

# Chave usada para assinar o cookie de sessão (qualquer texto aleatório)
SECRET_KEY=uma-chave-secreta-qualquer

# Projeto Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=SUA-CHAVE-SERVICE_ROLE
