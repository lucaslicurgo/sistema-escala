# Copie este arquivo para .env e preencha:

# Código de convite para criar conta (vazio = cadastro desligado)
CODIGO_CONVITE=troque-este-codigo

# Endereço público do app (opcional; usado no link de recuperar senha e cookie seguro)
APP_URL=https://seu-app.onrender.com

# Chave usada para assinar o cookie de sessão (qualquer texto aleatório)
SECRET_KEY=uma-chave-secreta-qualquer

# Projeto Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=SUA-CHAVE-SERVICE_ROLE
